# Voorbeeld van omgevingsvariabelen (zonder echte waarden). Kopieer naar .env.local voor lokaal gebruik;
# .env.local staat in .gitignore en komt nooit in de repository.

# TURN voor het live klaslokaal (alleen server-side; wordt via /api/turn alleen aan ingelogde gebruikers gegeven).
# Plak hier de "ICE Servers Array" uit het Metered-dashboard als JSON op één regel, bijvoorbeeld:
# TURN_ICE_SERVERS=[{"urls":"stun:stun.relay.metered.ca:80"},{"urls":"turn:global.relay.metered.ca:80","username":"...","credential":"..."}]
# Leeg of ongeldig = alleen STUN (directe verbindingen blijven werken).
TURN_ICE_SERVERS=